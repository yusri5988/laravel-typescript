{
  "name": "hono-laravel",
  "version": "0.1.0",
  "description": "Hono + TypeScript + Drizzle template with a Laravel-inspired directory structure, built for Cloudflare Workers.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run build:frontend && wrangler dev --local --ip 127.0.0.1 --port 8787",
    "dev:frontend": "vite",
    "dev:backend": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "tsc --noEmit",
    "preview": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "typegen": "wrangler types worker-configuration.d.ts",
    "build:cli-template": "node ./scripts/build-cli-template.mjs",
    "pack:cli": "npm pack ./packages/cli",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply hono-laravel --local",
    "db:migrate:remote": "wrangler d1 migrations apply hono-laravel --remote",
    "db:push": "drizzle-kit push",
    "db:seed": "wrangler d1 execute hono-laravel --local --file=./src/database/seeders/seed.sql",
    "db:seed:remote": "wrangler d1 execute hono-laravel --remote --file=./src/database/seeders/seed.sql",
    "setup:d1": "powershell -ExecutionPolicy Bypass -File ./scripts/setup.ps1",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "nanoid": "3.3.17"
  }
}
