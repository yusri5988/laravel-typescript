{
  "name": "hono-laravel",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    "APP_NAME": "hono-laravel",
    "CORS_ORIGIN": "http://localhost:5173"
  },
  "secrets": {
    "required": ["JWT_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hono-laravel",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "src/database/migrations"
    }
  ],
  // Example Durable Object binding (uncomment to use):
  // "durable_objects": {
  //   "bindings": [
  //     {
  //       "name": "RATE_LIMITER",
  //       "class_name": "RateLimiter"
  //     }
  //   ]
  // },
  // "workers_dev": true,
  // "routes": [
  //   {
  //     "pattern": "example.com/*",
  //     "zone_name": "example.com"
  //   }
  // ],
  "minify": true
}
