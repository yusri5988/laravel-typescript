# Hono Laravel Template — Environment Variables
# Copy this file to `.dev.vars` for local development (Cloudflare Workers loads .dev.vars automatically).

# Local D1 sqlite file used by drizzle-kit for generating/pushing migrations
DATABASE_URL=./wrangler-local-state/.tmp/d1/hono-laravel.sqlite

# Local signing secret for JWT auth middleware.
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-local-secret

# Optional comma-separated browser origins allowed to call the API.
# Leave empty for same-origin requests; configure explicit origins per environment.
CORS_ORIGINS=
